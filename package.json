{
  "name": "zec-refund-helper",
  "version": "0.1.0",
  "description": "Find a Zcash (or Bitcoin) deposit stuck in the NEAR Omni bridge from its transaction hash, and the bridge's own refund steps. Keyless, read-only, never signs.",
  "license": "MIT",
  "author": "Cryppit",
  "type": "module",
  "bin": {
    "zec-refund": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "zec-refund": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
